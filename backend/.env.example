ENV=dev
BACKEND_BIND_ALL_INTERFACES=0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0

LOCAL_DATA_DIR=data
IDENTITY_STORE_PATH=identity_memory.json

# SarahNode is local-first. Use 'local' for Ollama/llama.cpp, 'openai' for cloud,
# or 'mock' only for development diagnostics.
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_API_KEY=local
LOCAL_LLM_TEMPERATURE=0.4
LOCAL_LLM_MAX_TOOL_ROUNDS=5

# Phase 5 screen awareness. The vision model is used only for explicit screen-inspection requests.
SCREEN_AWARENESS_ENABLED=1
LOCAL_VISION_MODEL=qwen3-vl:4b
SCREEN_VISION_TIMEOUT_SECONDS=60
SCREEN_CAPTURE_MAX_DIMENSION=2560
SCREEN_CAPTURE_JPEG_QUALITY=88
SCREEN_HIDE_SARAH_DURING_CAPTURE=1

TTS_PROVIDER=auto
STT_PROVIDER=auto

# Optional OpenAI cloud provider/fallback. Not required for local Sarah.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ENABLE_WEB_SEARCH=1
OPENAI_MAX_TOOL_ROUNDS=5
OPENAI_TRANSCRIPTION_MODEL=whisper-1

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_PAGES=3
WEB_FETCH_TIMEOUT_SECONDS=6
WEB_FETCH_MAX_CHARS=6000
